# Images are large and environment-specific: never commit them (GitHub rejects files over 100 MB)
images/*
!images/.gitkeep
*.ova
*.ovf
*.iso
*.vmdk

# Your own manifests with real environment details (keep examples/ public)
manifests/
*.local.yaml

# Your own local notes (never committed)
*.local.md

# Secrets
.env
*.pem
*.key
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.log
